{
  "name": "smsprocessor",
  "version": "1.0.0",
  "description": "A scalable SMS processing and querying backend using Node.js and PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "lint": "eslint . --config eslintconfig.lint.mjs --ext .js",
    "lint:fix": "eslint . --config eslintconfig.lint.mjs --ext .js --fix",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/chiramlittleton/smsprocessor.git"
  },
  "keywords": [
    "sms",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "Chiram Littleton",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chiramlittleton/smsprocessor/issues"
  },
  "homepage": "https://github.com/chiramlittleton/smsprocessor#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.14.1",
    "pg-promise": "^11.12.1",
    "rate-limiter-flexible": "^6.1.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.0",
    "node-mocks-http": "^1.16.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2"
  }
}
